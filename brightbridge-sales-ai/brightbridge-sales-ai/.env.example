# Copy to .env (never commit .env). On Hugging Face use Space Secrets instead.
GEMINI_API_KEY=
# Leave as is unless you want a specific model. If it is unavailable the app tries fallbacks automatically.
GEMINI_MODEL=gemini-flash-latest

# demo = synthetic data | real = import your own CSV/XLSX
DATA_MODE=demo

# Leave empty for local SQLite. For persistent production data use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=20000
